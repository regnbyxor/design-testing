{
  "id": "MM-STEAMTRAP-EFF-005",
  "name": "Steam Trap Efficiency Verification",
  "description": "Determines steam trap condition using correlated thermal and ultrasonic patterns.",
  "failure_modes": [
    "Failed open",
    "Failed closed"
  ],
  "inputs": {
    "tools": [
      "Thermal camera",
      "Acoustic camera"
    ],
    "measurements": [
      {
        "name": "upstream_temperature",
        "type": "number",
        "unit": "\u00b0C",
        "source": "thermal_camera"
      },
      {
        "name": "downstream_temperature",
        "type": "number",
        "unit": "\u00b0C",
        "source": "thermal_camera"
      },
      {
        "name": "ultrasonic_pattern",
        "type": "string",
        "source": "acoustic_camera"
      },
      {
        "name": "design_temperature_range",
        "type": "range",
        "unit": "\u00b0C",
        "source": "manual_input"
      }
    ]
  },
  "processing": {
    "calculations": [
      {
        "name": "temperature_delta",
        "formula": "upstream_temperature - downstream_temperature"
      }
    ],
    "logic": [
      "Match patterns to failure signatures"
    ]
  },
  "outputs": {
    "results": [
      {
        "name": "trap_condition",
        "type": "enum",
        "values": [
          "healthy",
          "failed_open",
          "failed_closed"
        ]
      },
      {
        "name": "estimated_energy_loss",
        "type": "enum",
        "values": [
          "low",
          "medium",
          "high"
        ]
      }
    ]
  }
}
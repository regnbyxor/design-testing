{
  "id": "MM-THERM-LEAK-001",
  "name": "Thermal Leak Detection \u2013 Static Equipment",
  "description": "Detects process leaks by identifying abnormal thermal patterns around flanges and joints.",
  "failure_modes": [
    "Gasket failure",
    "Flange misalignment",
    "Thermal expansion damage"
  ],
  "inputs": {
    "tools": [
      "Thermal camera"
    ],
    "measurements": [
      {
        "name": "thermal_image",
        "type": "image",
        "source": "thermal_camera"
      }
    ]
  },
  "processing": {
    "calculations": [],
    "logic": [
      "Operator visually inspects thermal image for anomalies"
    ]
  },
  "outputs": {
    "results": [
      {
        "name": "thermal_anomaly_detected",
        "type": "boolean"
      },
      {
        "name": "anomaly_location",
        "type": "string",
        "optional": true
      }
    ]
  }
}
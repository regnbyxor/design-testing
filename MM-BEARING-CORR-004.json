{
  "id": "MM-BEARING-CORR-004",
  "name": "Bearing Health Correlation Analysis",
  "description": "Evaluates bearing condition by correlating temperature and acoustic emissions.",
  "failure_modes": [
    "Lubrication loss",
    "Spalling",
    "Early bearing damage"
  ],
  "inputs": {
    "tools": [
      "Thermal camera",
      "Acoustic camera"
    ],
    "measurements": [
      {
        "name": "bearing_temperature",
        "type": "number",
        "unit": "\u00b0C",
        "source": "thermal_camera"
      },
      {
        "name": "acoustic_intensity",
        "type": "number",
        "unit": "dB",
        "source": "acoustic_camera"
      },
      {
        "name": "rotational_speed",
        "type": "number",
        "unit": "RPM",
        "source": "control_system"
      }
    ]
  },
  "processing": {
    "calculations": [
      {
        "name": "normalized_acoustic",
        "formula": "acoustic_intensity / rotational_speed"
      }
    ],
    "logic": [
      "Correlate indicators vs baseline"
    ]
  },
  "outputs": {
    "results": [
      {
        "name": "health_state",
        "type": "string"
      },
      {
        "name": "confidence",
        "type": "enum",
        "values": [
          "low",
          "medium",
          "high"
        ]
      }
    ]
  }
}
{
  "id": "MM-THERM-ELEC-003",
  "name": "Electrical Hotspot Thermal Assessment",
  "description": "Assesses electrical component health by measuring thermal rise under load.",
  "failure_modes": [
    "Loose connections",
    "Overload",
    "Contact resistance"
  ],
  "inputs": {
    "tools": [
      "Thermal camera"
    ],
    "measurements": [
      {
        "name": "component_temperature",
        "type": "number",
        "unit": "\u00b0C",
        "source": "thermal_camera"
      },
      {
        "name": "ambient_temperature",
        "type": "number",
        "unit": "\u00b0C",
        "source": "manual_or_sensor"
      }
    ]
  },
  "processing": {
    "calculations": [
      {
        "name": "temperature_rise",
        "formula": "component_temperature - ambient_temperature"
      }
    ],
    "logic": [
      "Compare temperature rise to thresholds"
    ]
  },
  "outputs": {
    "results": [
      {
        "name": "temperature_rise",
        "type": "number",
        "unit": "\u00b0C"
      },
      {
        "name": "condition_state",
        "type": "enum",
        "values": [
          "normal",
          "warning",
          "alarm"
        ]
      }
    ]
  }
}
{
  "id": "MM-ACOUSTIC-LEAK-002",
  "name": "Acoustic Air Leak Identification",
  "description": "Identifies compressed air or gas leaks using ultrasonic sound imaging.",
  "failure_modes": [
    "Cracked hoses",
    "Loose fittings",
    "Valve seat leakage"
  ],
  "inputs": {
    "tools": [
      "Acoustic camera"
    ],
    "measurements": [
      {
        "name": "acoustic_image",
        "type": "image",
        "source": "acoustic_camera"
      }
    ]
  },
  "processing": {
    "calculations": [],
    "logic": [
      "Confirm acoustic hotspot",
      "Assign qualitative severity"
    ]
  },
  "outputs": {
    "results": [
      {
        "name": "leak_detected",
        "type": "boolean"
      },
      {
        "name": "leak_severity",
        "type": "enum",
        "values": [
          "low",
          "medium",
          "high"
        ]
      }
    ]
  }
}